{
  "name": "webgpt-frontend-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/extension-host/sidepanel-app"
  ],
  "scripts": {
    "start": "npm run cloud:service",
    "railway:start": "node apps/webgpt-cloud-service/src/server.js",
    "build": "node scripts/build-extension.mjs",
    "cloud:service": "node apps/webgpt-cloud-service/src/server.js",
    "cloud:run": "node apps/browserbase-host/src/cli.js",
    "cloud:cleanup": "node scripts/cleanup-webgpt-runs.mjs",
    "test": "node --test",
    "package:extension": "node scripts/package-extension.mjs",
    "smoke:extension": "node scripts/smoke-extension.mjs",
    "smoke:cloud": "node apps/browserbase-host/src/cli.js --dry-run --url https://example.com --goal smoke"
  }
}
