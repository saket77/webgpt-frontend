{
  "manifest_version": 3,
  "name": "WebGPT Agent",
  "version": "1.0.2",

  "permissions": [
    "webNavigation",
    "scripting",
    "tabs",
    "storage",
    "sidePanel",
    "identity"
  ],

  "host_permissions": [
    "https://sheets.googleapis.com/*",
    "https://graph.microsoft.com/*",
    "https://login.microsoftonline.com/*",
    "https://accounts.zoho.com/*",
    "https://accounts.zoho.in/*",
    "https://accounts.zoho.eu/*",
    "https://accounts.zoho.com.au/*",
    "https://accounts.zoho.jp/*",
    "https://accounts.zoho.ca/*",
    "https://accounts.zoho.com.cn/*",
    "https://accounts.zoho.sa/*",
    "https://www.zohoapis.com/*",
    "https://www.zohoapis.in/*",
    "https://www.zohoapis.eu/*",
    "https://www.zohoapis.com.au/*",
    "https://www.zohoapis.jp/*",
    "https://www.zohoapis.ca/*",
    "https://www.zohoapis.com.cn/*",
    "https://www.zohoapis.sa/*"
  ],

  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "oauth2": {
    "client_id": "1027462228605-6debv5co0oummfvd268pro3vnjk4dmpl.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "icons": {
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "WebGPT",
    "default_icon": {
      "128": "icons/icon-128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
