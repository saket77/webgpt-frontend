{
  "manifest_version": 3,
  "name": "WebGPT Agent",
  "version": "1.0",

  "permissions": [
    "webNavigation",
    "scripting",
    "tabs",
    "storage",
    "sidePanel"
  ],

  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "icons": {
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "WebGPT",
    "default_icon": {
      "128": "icons/icon-128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
